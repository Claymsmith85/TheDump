	GroupPrefix = 'cs-sendgrid-'

	Admin = [ordered]@{
		Key          = 'admin'
		GroupName    = 'cs-sendgrid-admin'
		RoleKind     = 'administrator'
		AccessTarget = 'main-and-all-subusers'
