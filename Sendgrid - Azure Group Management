		Key          = 'admin-ro'
		GroupName    = 'cs-sendgrid-admin-ro'
		RoleKind     = 'persona'
		PersonaSlug  = 'observer'
		AccessTarget = 'main-and-all-subusers'
		Precedence   = 200
		Notes        = 'Read-only baseline mapped to Observer persona unless overridden.'
	}

	SubuserPersona = [ordered]@{
		Key          = 'subuser-persona'
		RoleKind     = 'persona'
		AccessTarget = 'single-subuser'
		Precedence   = 100
		# Format: cs-sendgrid-<subuser>-<persona>
		# Supported persona slugs are constrained to the keys in $SendGridPersonaScopes.
		GroupPattern = '^(?i)cs-sendgrid-(?<Subuser>[a-z0-9][a-z0-9-]*)-(?<Persona>accountant|developer|marketer|observer)$'
	}
}

