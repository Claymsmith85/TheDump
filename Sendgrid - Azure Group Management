# -----------------------------------------------------------------------------
# SendGrid Azure Group Management (Phase 1: read-only inventory + WhatIf)
# -----------------------------------------------------------------------------
# Purpose
# - Move SendGrid access management to Entra ID group-driven sync.
# - Source of truth: Entra groups.
# - Target: SendGrid SSO Teammates on the PARENT account. Per-Subuser access is
#   granted through the teammate's subuser_access list, never by creating
#   teammates inside a Subuser.
#
# Current state
# - Read-only inventory and WhatIf group plan. The only write path is teammate
#   removal, gated behind $ApplySendGridRemovals.
# - The proposed changes are also exported as CSV files ($ExportPlanCsv) so they
#   can be reviewed and hand-tweaked before anything is applied.
#
# Access model (parent-managed)
# - Every person is exactly one SSO Teammate on the parent account.
# - SendGrid constraint: a non-admin Teammate is EITHER parent-scoped (scopes on
#   the parent, no subuser_access) OR subuser-scoped (has_restricted_subuser_access
#   = true, one subuser_access entry per Subuser, no parent scopes). The two
#   cannot be combined on one Teammate.
#
# Access categories
# 1) Account Admin       cs-sendgrid-admin             -> is_admin = true
# 2) Account Read-Only   cs-sendgrid-admin-ro          -> parent Observer scopes,
#                                                        no subuser_access (see note)
# 3) Subuser access      cs-sendgrid-<subuser>-<role>  -> one subuser_access entry:
#      role = admin                                      permission_type = admin
#      role = accountant|developer|marketer|observer     permission_type = restricted,
#                                                        scopes = subuser persona template
#
# Note on admin-ro: parent scopes and subuser_access are mutually exclusive, so
# "read-only on the parent AND inside every Subuser" cannot be one Teammate.
# This spec models admin-ro as parent Observer (parent views include Subuser
# lists and stats). The alternative — restricted Observer access on every
# Subuser, kept current by the reconciler — is an open decision (see below).
#
# Persona templates
# - Parent personas use the documented persona scope lists ($SendGridPersonaScopes).
# - Restricted subuser_access accepts a different, smaller scope list. Subuser
#   templates are computed at load as: persona list INTERSECT
#   $SendGridSubuserRestrictedScopes. Dropped scopes are printed at startup.
# - Personas with campaigns access (marketer, developer) additionally get
#   marketing.read + marketing.automation.read: the UI gates the subuser
#   "Marketing" tab behind those, not the legacy marketing_campaigns.* scopes.
#
# Sync flow
# 1) Bootstrap/auth (Delinea -> SendGrid API key + Graph certificate).
# 2) Desired state from Graph: members of the role groups.
# 3) Current state from SendGrid, parent account only:
#    - GET /v3/teammates                              list (no scopes in the list)
#    - GET /v3/teammates/{username}/subuser_access    subuser-scoped teammates
#    - GET /v3/teammates/{username}                   parent-scoped teammates
# 4) Reconcile (Phase 2+):
#    - Create: POST  /v3/sso/teammates  with has_restricted_subuser_access + subuser_access
#    - Update: PATCH /v3/sso/teammates/{username} with the FULL desired subuser_access list
#    - Remove: DELETE /v3/teammates/{username}
# 5) Legacy: teammates that exist inside a Subuser (created on-behalf-of) are
#    inventoried, mapped to groups, and flagged for migration: recreate at the
#    parent with subuser_access, then delete the Subuser-context teammate.
#
# Conflict rules
# - admin > admin-ro > subuser access. Admin ignores all other groups.
# - admin-ro together with any subuser group is a conflict (cannot coexist on
#   one Teammate): warn, apply nothing for that user.
# - Unknown subuser/persona in a group name: warn and continue.
# - Teammate with custom (non-persona) scopes on a SUBUSER: when in doubt,
#   propose read-only for that subuser only — the cs-sendgrid-<subuser>-observer
#   group ($FallbackToSubuserObserver, tagged 'fallback-observer' in the plan).
#   Parent-scoped doubt has no "their subuser" target, so it stays manual:
#   warn only, add by hand in the plan CSVs.
#
# Identity
# - SSO Teammate username == email and must match the IdP claim.
# - Primary key: Entra UPN (lowercase, trimmed). Fallback: mail. No display-name matching.
#
# Guardrails (Phase 2+)
# - -WhatIf / dry-run first class; explicit confirmation for removals.
# - Optional allowlist of target groups; optional denylist of protected teammates.
# - Retry/backoff for Graph and SendGrid throttling; no secrets in logs.
#
# Open design questions
# - admin-ro: parent Observer (current) vs restricted Observer on all Subusers.
# - Baseline groups: pre-create every <subuser>-<role> group (current) vs create on demand.
# - Orphaned teammates: remove vs disable; exception process for one-off manual access.
# - Notification channel for reconciliation changes/failures.
#
# Phases
# Phase 1 (this file): inventory + WhatIf group plan + removal candidates + CSV plan export.
# Phase 2: create/update parent teammates (subuser_access) from group membership.
# Phase 3: migrate legacy Subuser-context teammates; approved removals.
# Phase 4: scheduled run + monitoring/alerting.
# -----------------------------------------------------------------------------

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

# Fill-in input block
$Region = 'Global' # Global | EU
$GroupPrefix = 'cs-sendgrid-'
$SsoAccessGroupName = 'cs-ea-Sendgrid-users'
$SendGridSecretIdOverride = $null # Optional int secret ID override
$GraphCertSecretIdOverride = $null # Optional int secret ID override
$EmitMemberDetail = $true
$ApplySendGridRemovals = $false # Set $true to remove disabled/not-found users from SendGrid
$FallbackToSubuserObserver = $true # When subuser scopes match no persona, propose read-only (observer) for that subuser only
$ExportPlanCsv = $true # Export the proposed changes as CSV files for manual review/tweaks
$ExportFolderOverride = $null # Optional export folder; default: <script folder>\SendGridPlan_<timestamp>

# Resolve this script's folder whether run as a file (F5) or via "Run Selection" (F8)
$ScriptDir = if ($PSScriptRoot) {
	$PSScriptRoot
} elseif (Get-Variable -Name psEditor -ErrorAction SilentlyContinue) {
	Split-Path $psEditor.GetEditorContext().CurrentFile.Path
} else {
	$PWD.Path
}

. "$ScriptDir\..\config\LocalVariables.ps1"
. "$ScriptDir\..\Delinea\DelineaAuth.ps1"
. "$ScriptDir\Sendgrid API Functions.ps1"

Import-Module Microsoft.Graph.Authentication -ErrorAction Stop
Import-Module Microsoft.Graph.Groups -ErrorAction Stop
Import-Module Microsoft.Graph.Users -ErrorAction Stop

function Get-OptionalObjectProperty {
	[CmdletBinding()]
	param(
		[object]$InputObject,
		[string]$Name,
		$Default = $null
	)

	if ($null -eq $InputObject) {
		return $Default
	}

	$prop = $InputObject.PSObject.Properties[$Name]
	if ($null -ne $prop) {
		return $prop.Value
	}

	return $Default
}

# --- SendGrid calls this phase needs beyond the shared wrapper ---------------
# Both functions call Invoke-SendGridRequest from 'Sendgrid API Functions.ps1'.
# Expected contract:
#   Invoke-SendGridRequest -Client <client> -Method GET -Path '/v3/...' [-Query <hashtable>] [-OnBehalfOf <subuser>]
#   -> parsed JSON object
# If the shared file exposes its generic request function under another name or
# signature, change only these two functions.

function Get-SendGridTeammateSubuserAccess {
	[CmdletBinding()]
	param(
		[Parameter(Mandatory)]
		[object]$Client,
		[Parameter(Mandatory)]
		[string]$Username,
		[int]$PageSize = 100
	)

	$entries = New-Object System.Collections.Generic.List[object]
	$hasRestricted = $false
	$afterSubuserId = $null
	$path = '/v3/teammates/{0}/subuser_access' -f [uri]::EscapeDataString($Username)

	do {
		$query = @{ limit = $PageSize }
		if ($null -ne $afterSubuserId) {
			$query['after_subuser_id'] = $afterSubuserId
		}

		$response = Invoke-SendGridRequest -Client $Client -Method GET -Path $path -Query $query

		$hasRestricted = [bool](Get-OptionalObjectProperty -InputObject $response -Name 'has_restricted_subuser_access' -Default $false)
		foreach ($entry in @((Get-OptionalObjectProperty -InputObject $response -Name 'subuser_access' -Default @()))) {
			if ($null -ne $entry) {
				[void]$entries.Add($entry)
			}
		}

		$metadata = Get-OptionalObjectProperty -InputObject $response -Name '_metadata' -Default $null
		$afterSubuserId = Get-OptionalObjectProperty -InputObject $metadata -Name 'after_subuser_id' -Default $null
	} while ($null -ne $afterSubuserId)

	return [pscustomobject]@{
		Username                   = $Username
		HasRestrictedSubuserAccess = $hasRestricted
		SubuserAccess              = $entries.ToArray()
	}
}

function Get-SendGridTeammateDetail {
	[CmdletBinding()]
	param(
		[Parameter(Mandatory)]
		[object]$Client,
		[Parameter(Mandatory)]
		[string]$Username,
		[string]$OnBehalfOf
	)

	$path = '/v3/teammates/{0}' -f [uri]::EscapeDataString($Username)

	if (-not [string]::IsNullOrWhiteSpace($OnBehalfOf)) {
		return Invoke-SendGridRequest -Client $Client -Method GET -Path $path -OnBehalfOf $OnBehalfOf
	}

	return Invoke-SendGridRequest -Client $Client -Method GET -Path $path
}

function Get-SendGridTeammateLookupKey {
	[CmdletBinding()]
	param(
		[Parameter(Mandatory)]
		[object]$Teammate
	)

	$username = [string](Get-OptionalObjectProperty -InputObject $Teammate -Name 'username' -Default '')
	if (-not [string]::IsNullOrWhiteSpace($username)) {
		return $username
	}

	$email = [string](Get-OptionalObjectProperty -InputObject $Teammate -Name 'email' -Default '')
	if (-not [string]::IsNullOrWhiteSpace($email)) {
		return $email
	}

	return $null
}

function Add-RequiredGroupEntry {
	[CmdletBinding()]
	param(
		[Parameter(Mandatory)]
		[System.Collections.Generic.Dictionary[string, object]]$Map,
		[Parameter(Mandatory)]
		[string]$GroupName,
		[Parameter(Mandatory)]
		[string]$Reason,
		[string]$Member
	)

	$groupKey = $GroupName.Trim().ToLowerInvariant()
	if (-not $Map.ContainsKey($groupKey)) {
		$Map[$groupKey] = [ordered]@{
			GroupName = $groupKey
			Reasons   = New-Object System.Collections.Generic.List[string]
			Members   = New-Object System.Collections.Generic.List[string]
		}
	}

	$entry = $Map[$groupKey]
	if (-not $entry.Reasons.Contains($Reason)) {
		[void]$entry.Reasons.Add($Reason)
	}

	if (-not [string]::IsNullOrWhiteSpace($Member) -and -not $entry.Members.Contains($Member)) {
		[void]$entry.Members.Add($Member)
	}
}

function Add-ParentManagedAccess {
	# Records that a parent-account teammate already covers a subuser ('*' = all, via is_admin).
	[CmdletBinding()]
	param(
		[Parameter(Mandatory)]
		[System.Collections.Generic.Dictionary[string, object]]$Map,
		[Parameter(Mandatory)]
		[string]$Email,
		[Parameter(Mandatory)]
		[string]$SubuserToken
	)

	$key = $Email.Trim().ToLowerInvariant()
	if (-not $Map.ContainsKey($key)) {
		$Map[$key] = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)
	}

	[void]$Map[$key].Add($SubuserToken)
}

function Test-ParentManagedAccess {
	[CmdletBinding()]
	param(
		[Parameter(Mandatory)]
		[System.Collections.Generic.Dictionary[string, object]]$Map,
		[Parameter(Mandatory)]
		[string]$Email,
		[Parameter(Mandatory)]
		[string]$SubuserToken
	)

	$key = $Email.Trim().ToLowerInvariant()
	if (-not $Map.ContainsKey($key)) {
		return $false
	}

	return ($Map[$key].Contains('*') -or $Map[$key].Contains($SubuserToken))
}

function Get-ExistingSendGridGroupsFromGraph {
	[CmdletBinding()]
	param(
		[Parameter(Mandatory)]
		[string]$Prefix
	)

	$filter = "startswith(displayName,'$Prefix')"
	$groups = @(Get-MgGroup -Filter $filter -All -Property Id,DisplayName)

	$set = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)
	foreach ($g in $groups) {
		if (-not [string]::IsNullOrWhiteSpace([string]$g.DisplayName)) {
			[void]$set.Add($g.DisplayName.Trim().ToLowerInvariant())
		}
	}

	return [pscustomobject]@{
		Groups  = $groups
		NameSet = $set
	}
}

function Get-EntraGroupByDisplayNameExact {
	[CmdletBinding()]
	param(
		[Parameter(Mandatory)]
		[string]$DisplayName
	)

	$escapedName = $DisplayName.Replace("'", "''")
	$groups = @(Get-MgGroup -Filter "displayName eq '$escapedName'" -All -Property Id,DisplayName)
	if ($groups.Count -eq 0) {
		return $null
	}

	if ($groups.Count -gt 1) {
		throw "Multiple Entra groups found with displayName '$DisplayName'."
	}

	return $groups[0]
}

function Get-EntraGroupMemberUpnSet {
	# Direct user members only. One paged call instead of one Get-MgUser per member.
	[CmdletBinding()]
	param(
		[Parameter(Mandatory)]
		[string]$GroupId
	)

	$set = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)
	$users = @(Get-MgGroupMemberAsUser -GroupId $GroupId -All -Property Id,UserPrincipalName)

	foreach ($user in $users) {
		$upn = [string](Get-OptionalObjectProperty -InputObject $user -Name 'UserPrincipalName' -Default '')
		if (-not [string]::IsNullOrWhiteSpace($upn)) {
			[void]$set.Add($upn.Trim().ToLowerInvariant())
		}
	}

	# Comma prevents PowerShell from unrolling the HashSet into the pipeline on return.
	return ,$set
}

function Resolve-EntraUserStatusByEmail {
	[CmdletBinding()]
	param(
		[Parameter(Mandatory)]
		[string]$Email
	)

	$normalized = $Email.Trim().ToLowerInvariant()
	if ([string]::IsNullOrWhiteSpace($normalized)) {
		return [pscustomobject]@{
			Exists            = $false
			IsEnabled         = $false
			UserPrincipalName = $null
			UserId            = $null
			Reason            = 'missing-email'
		}
	}

	$user = $null
	try {
		$user = Get-MgUser -UserId $normalized -Property Id,UserPrincipalName,Mail,AccountEnabled
	}
	catch {
		$user = $null
	}

	if ($null -eq $user) {
		$escaped = $normalized.Replace("'", "''")
		$candidates = @(Get-MgUser -Filter "mail eq '$escaped' or userPrincipalName eq '$escaped'" -All -Property Id,UserPrincipalName,Mail,AccountEnabled)
		if ($candidates.Count -gt 0) {
			$exact = $candidates | Where-Object { (([string]$_.UserPrincipalName).Trim().ToLowerInvariant() -eq $normalized) -or (([string]$_.Mail).Trim().ToLowerInvariant() -eq $normalized) } | Select-Object -First 1
			$user = if ($exact) { $exact } else { $candidates[0] }
		}
	}

	if ($null -eq $user) {
		return [pscustomobject]@{
			Exists            = $false
			IsEnabled         = $false
			UserPrincipalName = $null
			UserId            = $null
			Reason            = 'not-found'
		}
	}

	$upn = [string](Get-OptionalObjectProperty -InputObject $user -Name 'UserPrincipalName' -Default $normalized)
	$enabled = [bool](Get-OptionalObjectProperty -InputObject $user -Name 'AccountEnabled' -Default $true)

	return [pscustomobject]@{
		Exists            = $true
		IsEnabled         = $enabled
		UserPrincipalName = $upn.Trim().ToLowerInvariant()
		UserId            = [string](Get-OptionalObjectProperty -InputObject $user -Name 'Id' -Default '')
		Reason            = if ($enabled) { 'ok' } else { 'disabled' }
	}
}

if ($Region -notin @('Global', 'EU')) {
	throw "Invalid Region '$Region'. Valid values: Global, EU."
}

foreach ($required in @('TenantId', 'EntraClientId', 'SsBase', 'SendGridSecretId', 'SsSecretId')) {
	if (-not (Get-Variable -Name $required -Scope Script -ErrorAction SilentlyContinue) -or
		[string]::IsNullOrWhiteSpace([string](Get-Variable -Name $required -Scope Script).Value)) {
		throw "Required config variable '$required' is missing or empty. Check config/LocalVariables.ps1."
	}
}

if (-not (Get-Command -Name 'Invoke-SendGridRequest' -ErrorAction SilentlyContinue)) {
	throw "Invoke-SendGridRequest was not found in 'Sendgrid API Functions.ps1'. Point Get-SendGridTeammateSubuserAccess and Get-SendGridTeammateDetail at the shared generic request function before running."
}

$sendGridSecretId = if ($null -ne $SendGridSecretIdOverride) { [int]$SendGridSecretIdOverride } else { [int]$SendGridSecretId }
$graphSecretId = if ($null -ne $GraphCertSecretIdOverride) { [int]$GraphCertSecretIdOverride } else { [int]$SsSecretId }

Write-Host ''
Write-Host 'Preparing SendGrid + Graph clients...' -ForegroundColor Cyan

$ssToken = Get-DelineaToken -SsBase $SsBase -ProbeSecretId $sendGridSecretId -Comment 'SendGrid group migration read-only what-if inventory.'

$sendGridClient = New-SendGridClientFromDelinea -SsBase $SsBase -SecretId $sendGridSecretId -SsToken $ssToken -Region $Region -DefaultPageSize 500
$pfx = Get-SecretServerPfxObject -SecretId $graphSecretId -SsBase $SsBase -SsToken $ssToken

Disconnect-MgGraph -ErrorAction SilentlyContinue | Out-Null
Connect-MgGraph -TenantId $TenantId -ClientId $EntraClientId -Certificate $pfx.Cert -NoWelcome | Out-Null

Write-Host 'Subuser persona templates (persona scopes limited to restricted subuser_access scopes):' -ForegroundColor Cyan
foreach ($personaKey in @($SendGridSubuserPersonaScopes.Keys)) {
	$dropped = @($SendGridSubuserPersonaDroppedScopes[$personaKey])
	Write-Host ("  {0,-10} {1,3} scope(s); {2} parent-only scope(s) dropped" -f $personaKey, @($SendGridSubuserPersonaScopes[$personaKey]).Count, $dropped.Count)
	if ($EmitMemberDetail -and $dropped.Count -gt 0) {
		Write-Host ("             dropped: {0}" -f ($dropped -join ', ')) -ForegroundColor DarkGray
	}
}

$requiredGroups = New-Object 'System.Collections.Generic.Dictionary[string, object]' ([System.StringComparer]::OrdinalIgnoreCase)
$warnings = New-Object System.Collections.Generic.List[string]
$inferredMembers = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)
$memberByEmail = New-Object 'System.Collections.Generic.Dictionary[string, string]' ([System.StringComparer]::OrdinalIgnoreCase)
$parentManagedAccess = New-Object 'System.Collections.Generic.Dictionary[string, object]' ([System.StringComparer]::OrdinalIgnoreCase)
$sendGridRemovalCandidates = New-Object System.Collections.Generic.List[object]
$legacyTeammates = New-Object System.Collections.Generic.List[object]

Write-Host 'Reading SendGrid subusers...' -ForegroundColor Cyan
$subusers = @(Get-SendGridSubusers -Client $sendGridClient -PageSize 500)
$subuserNameById = New-Object 'System.Collections.Generic.Dictionary[string, string]' ([System.StringComparer]::OrdinalIgnoreCase)
$subuserRoleSlugs = @('admin') + @(Get-SupportedPersonaSlugs)
Write-Host ("  Found {0} subuser(s); baseline is {1} role group(s) per subuser." -f $subusers.Count, $subuserRoleSlugs.Count)

foreach ($subuser in $subusers) {
	$subuserName = [string](Get-OptionalObjectProperty -InputObject $subuser -Name 'username' -Default '')
	if ([string]::IsNullOrWhiteSpace($subuserName)) {
		continue
	}

	$subuserId = [string](Get-OptionalObjectProperty -InputObject $subuser -Name 'id' -Default '')
	if (-not [string]::IsNullOrWhiteSpace($subuserId)) {
		$subuserNameById[$subuserId] = $subuserName
	}

	$subuserToken = ConvertTo-GroupToken -Value $subuserName
	foreach ($roleSlug in $subuserRoleSlugs) {
		$groupName = '{0}{1}-{2}' -f $GroupPrefix, $subuserToken, $roleSlug
		Add-RequiredGroupEntry -Map $requiredGroups -GroupName $groupName -Reason 'subuser-baseline' -Member $null
	}
}

Write-Host 'Reading parent-account teammates...' -ForegroundColor Cyan
$teammates = @(Get-SendGridTeammates -Client $sendGridClient -PageSize 500)
Write-Host ("  Found {0} teammate(s) on parent account." -f $teammates.Count)

foreach ($teammate in $teammates) {
	$email = [string](Get-OptionalObjectProperty -InputObject $teammate -Name 'email' -Default '')
	$username = [string](Get-OptionalObjectProperty -InputObject $teammate -Name 'username' -Default '')
	$lookupKey = Get-SendGridTeammateLookupKey -Teammate $teammate
	$memberKey = if (-not [string]::IsNullOrWhiteSpace($email)) { $email.Trim().ToLowerInvariant() } else { [string]$lookupKey }

	if (-not [string]::IsNullOrWhiteSpace($email)) {
		$entraState = Resolve-EntraUserStatusByEmail -Email $email
		if (-not $entraState.Exists -or -not $entraState.IsEnabled) {
			$reason = if (-not $entraState.Exists) { 'not-found-in-entra' } else { 'entra-user-disabled' }
			[void]$sendGridRemovalCandidates.Add([pscustomobject]@{
				TeammateLookupKey = $lookupKey
				TeammateEmail     = $email.Trim().ToLowerInvariant()
				Scope             = 'parent'
				Subuser           = $null
				Reason            = $reason
			})

			if (-not [string]::IsNullOrWhiteSpace($lookupKey)) {
				[void]$warnings.Add("Parent teammate '$lookupKey' marked for removal ($reason).")
			}

			continue
		}

		$memberKey = $entraState.UserPrincipalName
	}
	elseif (-not [string]::IsNullOrWhiteSpace($lookupKey)) {
		[void]$warnings.Add("Parent teammate '$lookupKey' has no email; skipping disabled/not-found Entra validation.")
	}

	if (-not [string]::IsNullOrWhiteSpace($memberKey)) {
		[void]$inferredMembers.Add($memberKey.Trim().ToLowerInvariant())
	}

	if (-not [string]::IsNullOrWhiteSpace($email) -and -not [string]::IsNullOrWhiteSpace($memberKey)) {
		$memberByEmail[$email.Trim().ToLowerInvariant()] = $memberKey.Trim().ToLowerInvariant()
	}

	$isAdmin = [bool](Get-OptionalObjectProperty -InputObject $teammate -Name 'is_admin' -Default $false)
	if ($isAdmin) {
		Add-RequiredGroupEntry -Map $requiredGroups -GroupName $SendGridRoleSpec.Admin.GroupName -Reason 'parent-admin' -Member $memberKey
		if (-not [string]::IsNullOrWhiteSpace($email)) {
			Add-ParentManagedAccess -Map $parentManagedAccess -Email $email -SubuserToken '*'
		}
		continue
	}

	if ([string]::IsNullOrWhiteSpace($username)) {
		[void]$warnings.Add("Parent teammate '$memberKey' has no username; cannot read subuser access or scopes.")
		continue
	}

	# Subuser-scoped teammate: access is carried on subuser_access entries.
	$access = $null
	try {
		$access = Get-SendGridTeammateSubuserAccess -Client $sendGridClient -Username $username
	}
	catch {
		$msg = Get-SendGridErrorMessage -ErrorRecord $_
		[void]$warnings.Add("Could not read subuser access for parent teammate '$username': $msg")
		continue
	}

	if ($access.HasRestrictedSubuserAccess) {
		foreach ($entry in $access.SubuserAccess) {
			$entryId = [string](Get-OptionalObjectProperty -InputObject $entry -Name 'id' -Default '')
			$entrySubuser = [string](Get-OptionalObjectProperty -InputObject $entry -Name 'username' -Default '')
			if ([string]::IsNullOrWhiteSpace($entrySubuser) -and $subuserNameById.ContainsKey($entryId)) {
				$entrySubuser = $subuserNameById[$entryId]
			}

			if ([string]::IsNullOrWhiteSpace($entrySubuser)) {
				[void]$warnings.Add("Parent teammate '$memberKey' has subuser access to unknown subuser id '$entryId'.")
				continue
			}

			$subuserToken = ConvertTo-GroupToken -Value $entrySubuser
			if (-not [string]::IsNullOrWhiteSpace($email)) {
				Add-ParentManagedAccess -Map $parentManagedAccess -Email $email -SubuserToken $subuserToken
			}

			$permissionType = ([string](Get-OptionalObjectProperty -InputObject $entry -Name 'permission_type' -Default '')).Trim().ToLowerInvariant()
			if ($permissionType -eq 'admin') {
				$groupName = '{0}{1}-admin' -f $GroupPrefix, $subuserToken
				Add-RequiredGroupEntry -Map $requiredGroups -GroupName $groupName -Reason 'parent-subuser-access' -Member $memberKey
				continue
			}

			$entryScopes = @((Get-OptionalObjectProperty -InputObject $entry -Name 'scopes' -Default @()))
			$resolved = Resolve-SendGridPersonaFromScopes -Scopes $entryScopes -Scope Subuser

			if ([string]::IsNullOrWhiteSpace([string]$resolved.Persona)) {
				if (-not $FallbackToSubuserObserver) {
					[void]$warnings.Add("Parent teammate '$memberKey' on subuser '$entrySubuser' has custom scopes ($($entryScopes.Count)); no persona match. Manual mapping needed.")
					continue
				}

				[void]$warnings.Add("Parent teammate '$memberKey' on subuser '$entrySubuser' has custom scopes ($($entryScopes.Count)); no persona match. Defaulted to read-only (observer) for this subuser; review in the plan CSVs.")
				$groupName = '{0}{1}-observer' -f $GroupPrefix, $subuserToken
				Add-RequiredGroupEntry -Map $requiredGroups -GroupName $groupName -Reason 'fallback-observer' -Member $memberKey
				continue
			}

			if ($resolved.MatchType -eq 'superset') {
				[void]$warnings.Add("Parent teammate '$memberKey' on subuser '$entrySubuser' mapped to '$($resolved.Persona)' with extra scope(s): $(@($resolved.ExtraScopes) -join ', ')")
			}

			$groupName = '{0}{1}-{2}' -f $GroupPrefix, $subuserToken, $resolved.Persona
			Add-RequiredGroupEntry -Map $requiredGroups -GroupName $groupName -Reason 'parent-subuser-access' -Member $memberKey
		}

		continue
	}

	# Parent-scoped, non-admin teammate: scopes live on the teammate itself (detail call).
	$detail = $null
	try {
		$detail = Get-SendGridTeammateDetail -Client $sendGridClient -Username $username
	}
	catch {
		$msg = Get-SendGridErrorMessage -ErrorRecord $_
		[void]$warnings.Add("Could not read scopes for parent teammate '$username': $msg")
		continue
	}

	$parentScopes = @((Get-OptionalObjectProperty -InputObject $detail -Name 'scopes' -Default @()))
	$resolved = Resolve-SendGridPersonaFromScopes -Scopes $parentScopes -Scope Parent

	if ($resolved.Persona -eq $SendGridRoleSpec.AdminReadOnly.PersonaSlug) {
		Add-RequiredGroupEntry -Map $requiredGroups -GroupName $SendGridRoleSpec.AdminReadOnly.GroupName -Reason 'parent-observer' -Member $memberKey
		if ($resolved.MatchType -eq 'superset') {
			[void]$warnings.Add("Parent teammate '$memberKey' mapped to admin-ro with extra scope(s): $(@($resolved.ExtraScopes) -join ', ')")
		}
	}
	elseif (-not [string]::IsNullOrWhiteSpace([string]$resolved.Persona)) {
		[void]$warnings.Add("Parent teammate '$memberKey' holds parent-level persona '$($resolved.Persona)'; only Observer maps to a group (admin-ro). Manual mapping needed.")
	}
	else {
		[void]$warnings.Add("Parent teammate '$memberKey' has custom parent scopes ($($parentScopes.Count)); no group mapping. Manual mapping needed.")
	}
}

Write-Host 'Reading legacy subuser-context teammates (on-behalf-of) for migration...' -ForegroundColor Cyan
foreach ($subuser in $subusers) {
	$subuserName = [string](Get-OptionalObjectProperty -InputObject $subuser -Name 'username' -Default '')
	if ([string]::IsNullOrWhiteSpace($subuserName)) {
		continue
	}

	$subuserToken = ConvertTo-GroupToken -Value $subuserName

	try {
		$subuserTeammates = @(Get-SendGridTeammates -Client $sendGridClient -OnBehalfOf $subuserName -PageSize 500)
	}
	catch {
		$msg = Get-SendGridErrorMessage -ErrorRecord $_
		[void]$warnings.Add("Could not read teammates on subuser '$subuserName' via on-behalf-of: $msg")
		continue
	}

	foreach ($subuserTeammate in $subuserTeammates) {
		$subEmail = [string](Get-OptionalObjectProperty -InputObject $subuserTeammate -Name 'email' -Default '')
		if ([string]::IsNullOrWhiteSpace($subEmail)) {
			continue
		}

		# Already covered from the parent (admin, or a subuser_access entry for this subuser): not legacy.
		if (Test-ParentManagedAccess -Map $parentManagedAccess -Email $subEmail -SubuserToken $subuserToken) {
			continue
		}

		$subEmailKey = $subEmail.Trim().ToLowerInvariant()
		$subLookupKey = Get-SendGridTeammateLookupKey -Teammate $subuserTeammate
		$subTeammateUsername = [string](Get-OptionalObjectProperty -InputObject $subuserTeammate -Name 'username' -Default '')
		$displayKey = if ([string]::IsNullOrWhiteSpace($subLookupKey)) { $subEmailKey } else { $subLookupKey }

		$entraState = Resolve-EntraUserStatusByEmail -Email $subEmail
		if (-not $entraState.Exists -or -not $entraState.IsEnabled) {
			$reason = if (-not $entraState.Exists) { 'not-found-in-entra' } else { 'entra-user-disabled' }
			[void]$sendGridRemovalCandidates.Add([pscustomobject]@{
				TeammateLookupKey = $subLookupKey
				TeammateEmail     = $subEmailKey
				Scope             = 'subuser'
				Subuser           = $subuserName
				Reason            = $reason
			})
			[void]$warnings.Add("Legacy teammate '$displayKey' on subuser '$subuserName' marked for removal ($reason).")
			continue
		}

		$memberKey = $entraState.UserPrincipalName
		[void]$inferredMembers.Add($memberKey)
		$memberByEmail[$subEmailKey] = $memberKey

		$subIsAdmin = [bool](Get-OptionalObjectProperty -InputObject $subuserTeammate -Name 'is_admin' -Default $false)
		$mappedGroup = $null
		$mappedBy = $null

		if ($subIsAdmin) {
			$mappedGroup = '{0}{1}-admin' -f $GroupPrefix, $subuserToken
			$mappedBy = 'admin'
		}
		elseif ([string]::IsNullOrWhiteSpace($subTeammateUsername)) {
			[void]$warnings.Add("Legacy teammate '$displayKey' on subuser '$subuserName' has no username; cannot read scopes.")
		}
		else {
			$subScopes = @()
			try {
				$subDetail = Get-SendGridTeammateDetail -Client $sendGridClient -Username $subTeammateUsername -OnBehalfOf $subuserName
				$subScopes = @((Get-OptionalObjectProperty -InputObject $subDetail -Name 'scopes' -Default @()))
			}
			catch {
				$msg = Get-SendGridErrorMessage -ErrorRecord $_
				[void]$warnings.Add("Could not read scopes for legacy teammate '$displayKey' on subuser '$subuserName': $msg")
			}

			# A teammate inside a subuser holds full-account-style scopes; try the parent lists first.
			$resolved = Resolve-SendGridPersonaFromScopes -Scopes $subScopes -Scope Parent
			if ([string]::IsNullOrWhiteSpace([string]$resolved.Persona)) {
				$resolved = Resolve-SendGridPersonaFromScopes -Scopes $subScopes -Scope Subuser
			}

			if ([string]::IsNullOrWhiteSpace([string]$resolved.Persona)) {
				if ($FallbackToSubuserObserver) {
					[void]$warnings.Add("Legacy teammate '$displayKey' on subuser '$subuserName' did not map to a known persona ($($subScopes.Count) scope(s)). Defaulted to read-only (observer) for this subuser; review in the plan CSVs.")
					$mappedGroup = '{0}{1}-observer' -f $GroupPrefix, $subuserToken
					$mappedBy = 'observer-fallback'
				}
				else {
					[void]$warnings.Add("Legacy teammate '$displayKey' on subuser '$subuserName' did not map to a known persona ($($subScopes.Count) scope(s)). Manual mapping needed.")
				}
			}
			else {
				if ($resolved.MatchType -eq 'superset') {
					[void]$warnings.Add("Legacy teammate '$displayKey' on subuser '$subuserName' mapped to '$($resolved.Persona)' with extra scope(s): $(@($resolved.ExtraScopes) -join ', ')")
				}
				$mappedGroup = '{0}{1}-{2}' -f $GroupPrefix, $subuserToken, $resolved.Persona
				$mappedBy = 'persona'
			}
		}

		if (-not [string]::IsNullOrWhiteSpace([string]$mappedGroup)) {
			Add-RequiredGroupEntry -Map $requiredGroups -GroupName $mappedGroup -Reason 'legacy-subuser-teammate' -Member $memberKey
		}

		[void]$legacyTeammates.Add([pscustomobject]@{
			Subuser     = $subuserName
			Teammate    = $displayKey
			Member      = $memberKey
			MappedGroup = if ([string]::IsNullOrWhiteSpace([string]$mappedGroup)) { '(manual)' } else { $mappedGroup }
			MappedBy    = if ([string]::IsNullOrWhiteSpace([string]$mappedBy)) { '(manual)' } else { $mappedBy }
		})
	}
}

Write-Host 'Reading existing Entra groups...' -ForegroundColor Cyan
$existing = Get-ExistingSendGridGroupsFromGraph -Prefix $GroupPrefix

$required = @($requiredGroups.Values | Sort-Object -Property GroupName)
$missing = @($required | Where-Object { -not $existing.NameSet.Contains($_.GroupName) })
$alreadyExists = @($required | Where-Object { $existing.NameSet.Contains($_.GroupName) })

Write-Host ''
Write-Host 'WhatIf Group Creation Plan (mirror current SendGrid access)' -ForegroundColor Green
Write-Host ("  Required groups : {0}" -f $required.Count)
Write-Host ("  Existing groups : {0}" -f $alreadyExists.Count)
Write-Host ("  Missing groups  : {0}" -f $missing.Count)

if ($missing.Count -gt 0) {
	Write-Host ''
	Write-Host 'Groups to create:' -ForegroundColor Yellow
	$missing | Select-Object @{Name='GroupName';Expression={$_.GroupName}}, @{Name='Reasons';Expression={($_.Reasons -join '; ')}}, @{Name='MemberCount';Expression={$_.Members.Count}} | Format-Table -AutoSize -Wrap

	Write-Host ''
	Write-Host 'WhatIf actions:' -ForegroundColor Yellow
	foreach ($g in $missing) {
		Write-Host ("  [WhatIf] Would create Entra group: {0}" -f $g.GroupName)
	}
}
else {
	Write-Host ''
	Write-Host 'No missing groups. Existing Entra groups already cover mirrored SendGrid roles/personas.' -ForegroundColor Green
}

if ($EmitMemberDetail -and $required.Count -gt 0) {
	Write-Host ''
	Write-Host 'Role-source detail (group -> members inferred from SendGrid):' -ForegroundColor Cyan
	foreach ($g in $required) {
		$members = if ($g.Members.Count -gt 0) { $g.Members -join ', ' } else { '(none)' }
		Write-Host ("  {0}" -f $g.GroupName) -ForegroundColor DarkCyan
		Write-Host ("    Members: {0}" -f $members)
	}
}

Write-Host ''
Write-Host 'Legacy subuser-context teammates (to migrate to parent subuser_access)' -ForegroundColor Cyan
if ($legacyTeammates.Count -eq 0) {
	Write-Host '  None found. All subuser access is already managed from the parent account.' -ForegroundColor Green
}
else {
	Write-Host ("  Legacy teammates: {0}" -f $legacyTeammates.Count) -ForegroundColor Yellow
	$legacyTeammates | Sort-Object -Property Subuser, Teammate | Format-Table -AutoSize -Wrap
	Write-Host '  Migration (Phase 3): create/patch the parent SSO teammate with a subuser_access entry for the subuser, then delete the subuser-context teammate.' -ForegroundColor DarkYellow
}

if ($warnings.Count -gt 0) {
	Write-Host ''
	Write-Host 'Warnings / manual mapping needed:' -ForegroundColor DarkYellow
	$warnings | Sort-Object -Unique | ForEach-Object { Write-Host ("  - {0}" -f $_) -ForegroundColor DarkYellow }
}

Write-Host ''
Write-Host 'Disabled/NotFound Entra Users in SendGrid' -ForegroundColor Cyan
$uniqueRemovalCandidates = @($sendGridRemovalCandidates | Group-Object -Property TeammateLookupKey, Scope, Subuser | ForEach-Object { $_.Group | Select-Object -First 1 })
if ($uniqueRemovalCandidates.Count -eq 0) {
	Write-Host '  No removal candidates found.' -ForegroundColor Green
}
else {
	Write-Host ("  Removal candidates: {0}" -f $uniqueRemovalCandidates.Count) -ForegroundColor Yellow
	$uniqueRemovalCandidates |
		Select-Object @{Name='Teammate';Expression={$_.TeammateLookupKey}}, @{Name='Email';Expression={$_.TeammateEmail}}, Scope, Subuser, Reason |
		Format-Table -AutoSize -Wrap

	if ($ApplySendGridRemovals) {
		$removeSupportsOnBehalfOf = (Get-Command -Name 'Remove-SendGridTeammate').Parameters.ContainsKey('OnBehalfOf')

		Write-Host '  Applying SendGrid removals...' -ForegroundColor Yellow
		foreach ($candidate in $uniqueRemovalCandidates) {
			if ([string]::IsNullOrWhiteSpace([string]$candidate.TeammateLookupKey)) {
				continue
			}

			try {
				if ($candidate.Scope -eq 'parent') {
					Remove-SendGridTeammate -Client $sendGridClient -TeammateName $candidate.TeammateLookupKey -Confirm:$false
				}
				elseif ($removeSupportsOnBehalfOf) {
					Remove-SendGridTeammate -Client $sendGridClient -TeammateName $candidate.TeammateLookupKey -OnBehalfOf $candidate.Subuser -Confirm:$false
				}
				else {
					Write-Host ("  Skipped {0} on subuser {1}: Remove-SendGridTeammate has no -OnBehalfOf parameter." -f $candidate.TeammateLookupKey, $candidate.Subuser) -ForegroundColor DarkYellow
					continue
				}

				Write-Host ("  Removed teammate: {0} ({1})" -f $candidate.TeammateLookupKey, $candidate.Scope) -ForegroundColor Green
			}
			catch {
				$msg = Get-SendGridErrorMessage -ErrorRecord $_
				Write-Host ("  Failed to remove teammate {0}: {1}" -f $candidate.TeammateLookupKey, $msg) -ForegroundColor Red
			}
		}
	}
	else {
		foreach ($candidate in $uniqueRemovalCandidates) {
			$where = if ($candidate.Scope -eq 'parent') { 'parent' } else { "subuser $($candidate.Subuser)" }
			Write-Host ("  [WhatIf] Would remove SendGrid teammate: {0} on {1} ({2})" -f $candidate.TeammateLookupKey, $where, $candidate.Reason) -ForegroundColor Yellow
		}
	}
}

Write-Host ''
Write-Host ("SSO Access Group Check ({0})" -f $SsoAccessGroupName) -ForegroundColor Cyan

$ssoGroup = Get-EntraGroupByDisplayNameExact -DisplayName $SsoAccessGroupName
if ($null -eq $ssoGroup) {
	Write-Host ("  Group not found: {0}" -f $SsoAccessGroupName) -ForegroundColor Yellow
	if ($inferredMembers.Count -gt 0) {
		Write-Host ("  [WhatIf] Would create Entra group: {0}" -f $SsoAccessGroupName) -ForegroundColor Yellow
		Write-Host ("  [WhatIf] Would add {0} user(s) to {1} after creation." -f $inferredMembers.Count, $SsoAccessGroupName) -ForegroundColor Yellow
	}
}
else {
	$ssoMemberSet = Get-EntraGroupMemberUpnSet -GroupId $ssoGroup.Id
	$missingSsoMembers = @($inferredMembers | Where-Object { -not $ssoMemberSet.Contains($_) } | Sort-Object)

	Write-Host ("  Required users : {0}" -f $inferredMembers.Count)
	Write-Host ("  Current members: {0}" -f $ssoMemberSet.Count)
	Write-Host ("  Missing users  : {0}" -f $missingSsoMembers.Count)

	if ($missingSsoMembers.Count -gt 0) {
		Write-Host '  Users missing from SSO access group:' -ForegroundColor Yellow
		$missingSsoMembers | ForEach-Object { Write-Host ("    - {0}" -f $_) -ForegroundColor Yellow }
		Write-Host ("  [WhatIf] Would add missing users to {0}." -f $SsoAccessGroupName) -ForegroundColor Yellow
	}
	else {
		Write-Host '  All inferred SendGrid users are already in the SSO access group.' -ForegroundColor Green
	}
}

if ($ExportPlanCsv) {
	$exportFolder = if (-not [string]::IsNullOrWhiteSpace([string]$ExportFolderOverride)) {
		[string]$ExportFolderOverride
	}
	else {
		Join-Path $ScriptDir ('SendGridPlan_{0}' -f (Get-Date -Format 'yyyyMMdd-HHmmss'))
	}

	$null = New-Item -ItemType Directory -Path $exportFolder -Force

	Write-Host ''
	Write-Host ("Exporting proposed changes to {0}" -f $exportFolder) -ForegroundColor Cyan

	$groupRows = foreach ($g in $missing) {
		[pscustomobject]@{
			GroupName   = $g.GroupName
			MemberCount = $g.Members.Count
			Reasons     = ($g.Reasons -join '; ')
		}
	}
	Export-SendGridPlanCsv -Path (Join-Path $exportFolder '01-groups-to-create.csv') -Columns @('GroupName', 'MemberCount', 'Reasons') -Rows $groupRows

	$membershipRows = foreach ($g in $required) {
		foreach ($groupMember in $g.Members) {
			[pscustomobject]@{
				GroupName   = $g.GroupName
				MemberUpn   = $groupMember
				GroupExists = $existing.NameSet.Contains($g.GroupName)
				Reasons     = ($g.Reasons -join '; ')
			}
		}
	}
	Export-SendGridPlanCsv -Path (Join-Path $exportFolder '02-group-memberships.csv') -Columns @('GroupName', 'MemberUpn', 'GroupExists', 'Reasons') -Rows $membershipRows

	$removalRows = foreach ($candidate in $uniqueRemovalCandidates) {
		[pscustomobject]@{
			Teammate = $candidate.TeammateLookupKey
			Email    = $candidate.TeammateEmail
			Scope    = $candidate.Scope
			Subuser  = $candidate.Subuser
			Reason   = $candidate.Reason
		}
	}
	Export-SendGridPlanCsv -Path (Join-Path $exportFolder '03-sendgrid-teammate-removals.csv') -Columns @('Teammate', 'Email', 'Scope', 'Subuser', 'Reason') -Rows $removalRows

	Export-SendGridPlanCsv -Path (Join-Path $exportFolder '04-legacy-teammate-migrations.csv') -Columns @('Subuser', 'Teammate', 'Member', 'MappedGroup', 'MappedBy') -Rows $legacyTeammates.ToArray()

	$ssoGroupExists = ($null -ne $ssoGroup)
	$ssoProposedMembers = if ($ssoGroupExists) { @($missingSsoMembers) } else { @($inferredMembers | Sort-Object) }
	$ssoAdditionRows = foreach ($ssoMember in $ssoProposedMembers) {
		[pscustomobject]@{
			MemberUpn   = $ssoMember
			TargetGroup = $SsoAccessGroupName
			GroupExists = $ssoGroupExists
		}
	}
	Export-SendGridPlanCsv -Path (Join-Path $exportFolder '05-sso-group-additions.csv') -Columns @('MemberUpn', 'TargetGroup', 'GroupExists') -Rows $ssoAdditionRows

	$warningRows = foreach ($warning in @($warnings | Sort-Object -Unique)) {
		[pscustomobject]@{ Warning = $warning }
	}
	Export-SendGridPlanCsv -Path (Join-Path $exportFolder '06-warnings.csv') -Columns @('Warning') -Rows $warningRows
}

Disconnect-MgGraph -ErrorAction SilentlyContinue | Out-Null
